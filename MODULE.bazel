bazel_dep(name = "bazel_lib", version = "3.0.0")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.48.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "34.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_android", version = "0.7.1")
bazel_dep(name = "contrib_rules_jvm", version = "0.33.0")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "6.10")
bazel_dep(name = "grpc-java", version = "1.82.0", repo_name = "io_grpc_grpc_java")
single_version_override(
    module_name = "grpc-java",
    patch_strip = 1,
    patches = [
        # Remove overrides for maven coordinates that redirect them to io_grpc_grpc_java
        # Keep libraries in sync with version of io_grpc_grpc_java
        "//tools/bazel/grpc-java/patches:0001-Remove-overrides.patch",
    ],
    version = "1.82.0",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "co_atoms_go_lib_net_location",
    "co_atoms_go_lib_net_session",
    "co_atoms_go_splitter",
)

inject_repo(
    go_deps,
    "rules_go",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "ch.qos.logback:logback-classic:1.5.18",
        "co.atoms.lib.net.location:location:1.0.3",
        "co.atoms.lib.net.session:session:1.0.4",
        "com.github.ben-manes.caffeine:caffeine:3.1.8",
        "com.google.api.grpc:proto-google-common-protos:2.64.1",
        "com.google.code.findbugs:annotations:3.0.1",
        "com.google.guava:guava:33.5.0-jre",
        "com.google.protobuf:protobuf-java:4.34.1",
        "com.google.truth:truth:1.4.4",
        "io.grpc:grpc-api:1.82.0",
        "io.grpc:grpc-stub:1.82.0",
        "io.grpc:grpc-netty-shaded:1.82.0",
        "io.opentelemetry:opentelemetry-api:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-common:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-metrics:1.42.1",
        "net.logstash.logback:logstash-logback-encoder:6.3",
        "org.junit.jupiter:junit-jupiter-api:5.9.3",
        "org.junit.jupiter:junit-jupiter-engine:5.9.3",
        "org.junit.jupiter:junit-jupiter-params:5.9.3",
        "org.junit.platform:junit-platform-launcher:1.9.3",
        "org.junit.platform:junit-platform-reporting:1.9.3",
        "org.slf4j:slf4j-api:2.0.17",
        "org.yaml:snakeyaml:2.7",
    ],
    known_contributing_modules = [
        "",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

compat = use_extension("@rules_java//java:rules_java_deps.bzl", "compatibility_proxy")
use_repo(compat, "compatibility_proxy")
